PORT=8080
WS_HEARTBEAT_MS=30000
MAX_PAYLOAD_BYTES=1024
DATABASE_URL=
AUTH_SECRET=change-me-to-a-random-secret
MAX_TIMESTAMP_SKEW_MS=30000
MAX_ROOM_SIZE=500

# Minimum log severity level (debug | info | warn | error)
LOG_LEVEL=info

# Per-client message rate limit (messages per second)
MAX_MESSAGES_PER_SECOND=100

# Maximum new WebSocket connections allowed per IP address per minute
CONN_RATE_LIMIT=30
